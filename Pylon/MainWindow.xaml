<Window x:Class="Pylon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pylon"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Pylon" Width="1280" Height="760" MinWidth="820" MinHeight="460"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowDrop="True"
        Background="{DynamicResource BgA3}" FontFamily="{StaticResource Inter}" Foreground="{DynamicResource FgA2}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ───── Top bar ───── -->
        <Grid x:Name="TopBar" Background="{DynamicResource BgA3}">
            <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                <local:Icon Glyph="logo" Tint="@FgA0" Margin="7,0"/>
                <Button x:Name="MenuBtn" Style="{StaticResource IconButton}" Tag="dots-three" Padding="2" Margin="5,0,0,0"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{local:T 'Menu'}" Click="MenuBtn_Click"/>
                <ToggleButton x:Name="SidebarBtn" Style="{StaticResource IconButton}" Tag="sidebar-simple" Padding="2" Margin="6,0,0,0"
                              WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{local:T 'Library (Ctrl+L)'}" Click="SidebarBtn_Click"/>
                <Rectangle Width="1" Height="16" Fill="{DynamicResource DividerBright}" Margin="8,0"/>
                <Button x:Name="FolderBtn" Style="{StaticResource FlatButton}" Padding="2,0,6,0" Height="28" Click="FolderBtn_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" Visibility="Collapsed" ToolTip="{local:T 'Open this folder in the library'}">
                    <StackPanel Orientation="Horizontal">
                        <local:Icon Glyph="folder" Margin="0,0,4,0"/>
                        <TextBlock x:Name="FolderText" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock x:Name="TitleText" Text="Pylon" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="600"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Tag="minus" Padding="6,2" WindowChrome.IsHitTestVisibleInChrome="True" Click="Min_Click"/>
                <Button x:Name="MaxBtn" Style="{StaticResource IconButton}" Tag="square" Padding="6,2" WindowChrome.IsHitTestVisibleInChrome="True" Click="Max_Click"/>
                <Button Style="{StaticResource IconButton}" Tag="corners-out" Padding="6,2" WindowChrome.IsHitTestVisibleInChrome="True" Click="Full_Click" ToolTip="{local:T 'Fullscreen (F)'}"/>
                <Button Style="{StaticResource IconButton}" Tag="x" Padding="6,2" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- ───── Library + stage ───── -->
        <Grid x:Name="Middle" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- the panels sit in clipping hosts whose width springs open and shut, so the stage glides instead of jumping -->
            <Border x:Name="SidebarHost" ClipToBounds="True" Width="0" SizeChanged="PanelHost_SizeChanged">
                <local:LibraryPanel x:Name="Sidebar" Visibility="Collapsed" HorizontalAlignment="Right"/>
            </Border>
            <Border x:Name="FxHost" Grid.Column="2" ClipToBounds="True" Width="0" SizeChanged="PanelHost_SizeChanged">
                <local:EffectsPanel x:Name="FxPanel" Visibility="Collapsed" HorizontalAlignment="Left"/>
            </Border>

            <Grid x:Name="Stage" Grid.Column="1" Margin="10,1,10,0" MouseRightButtonUp="Stage_RightClick" MouseLeftButtonDown="DragArea_MouseDown" SizeChanged="Stage_SizeChanged">
                <!-- Idle / drop target -->
                <Border x:Name="IdleView" CornerRadius="10" Background="{DynamicResource BgB1}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <local:Icon x:Name="IdleLogo" Glyph="logo" Tint="@FgA0" Width="96" Height="96"/>
                        <TextBlock Text="{local:T 'Drop media here'}" FontSize="20" Foreground="{DynamicResource FgA1}" HorizontalAlignment="Center" Margin="0,24,0,6"/>
                        <TextBlock x:Name="IdleHint" Text="{local:T 'or press Ctrl + O to open a file, Ctrl + L for your library'}" FontSize="14" Foreground="{DynamicResource FgA3}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Music: blurred artwork backdrop + cover + caption -->
                <Grid x:Name="MusicView" Visibility="Collapsed" ClipToBounds="True">
                    <Rectangle Fill="{DynamicResource StageBg}"/>
                    <local:Backdrop x:Name="ArtBackdrop" Opacity="0.32"/>
                    <local:Spectrum x:Name="MusicSpectrum" Height="64" VerticalAlignment="Bottom" Margin="40,0,40,14" Opacity="0.5"/>
                    <Grid x:Name="MusicLayout" Margin="40,72,40,24" SizeChanged="MusicLayout_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="LyricsColumn" Width="0"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="ArtFrame" CornerRadius="12" Background="{DynamicResource BgB1}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Height="400" CacheMode="BitmapCache">
                            <Border.Effect><DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                            <Grid>
                                <local:Icon x:Name="ArtPlaceholder" Glyph="music-note" Width="96" Height="96" Tint="@FgA4"/>
                                <Image x:Name="ArtImage" Stretch="UniformToFill">
                                    <Image.Clip><RectangleGeometry x:Name="ArtClip" RadiusX="12" RadiusY="12"/></Image.Clip>
                                </Image>
                                <!-- play / pause flash after a click on the music view: in the middle of the cover -->
                                <Border x:Name="StageFlash" Width="88" Height="88" CornerRadius="44" Background="{DynamicResource MenuBg}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Opacity="0" IsHitTestVisible="False">
                                    <local:Icon x:Name="StageFlashIcon" Glyph="play-fill" Width="38" Height="38" Tint="@FgA0"/>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="MusicCaption" Grid.Row="1" FontSize="24" FontWeight="Medium" Foreground="{DynamicResource FgA1}"
                                   HorizontalAlignment="Center" Margin="0,40,0,0" TextTrimming="CharacterEllipsis"/>
                        <local:LyricsView x:Name="LyricsPane" Grid.Column="1" Grid.RowSpan="2" Margin="40,-48,0,0" Visibility="Collapsed"/>
                    </Grid>
                    <!-- miniplayer: the line being sung and the next one over the bottom of the cover -->
                    <Border x:Name="MiniLyrics" VerticalAlignment="Bottom" Padding="14,28,14,12" Visibility="Collapsed" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#D0000000" Offset="0.55"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock x:Name="MiniLyricNow" FontSize="17" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock x:Name="MiniLyricNext" FontSize="13" FontWeight="SemiBold" Foreground="#8CFFFFFF" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- OSD for everything that isn't video (music, idle); over video the one in the overlay window is used -->
                <Border x:Name="StageOsd" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24" Padding="12,6" Panel.ZIndex="5"
                        CornerRadius="6" Background="{DynamicResource MenuBg}" Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="StageOsdText" FontSize="16" Foreground="{DynamicResource FgA1}"/>
                </Border>


                <!-- Around the video: its own frames, blurred (sized to the picture, the video sits on top) -->
                <Grid x:Name="VideoBackdrop" Visibility="Collapsed">
                    <Rectangle Fill="{DynamicResource StageBg}"/>
                    <local:Backdrop x:Name="Ambient" Opacity="0.6"/>
                </Grid>

                <!-- Video (native HWND). Content renders in an overlay window on top of the video. -->
                <vlc:VideoView x:Name="Video" Visibility="Collapsed" Background="Black" SizeChanged="Video_SizeChanged">
                    <Grid x:Name="Overlay" Background="#01000000"
                          MouseLeftButtonDown="Overlay_MouseDown" MouseLeftButtonUp="Overlay_MouseUp" MouseMove="Overlay_MouseMove" MouseWheel="Overlay_MouseWheel" MouseRightButtonUp="Stage_RightClick">
                        <local:Spectrum x:Name="VideoSpectrum" Height="90" VerticalAlignment="Bottom" Margin="24,0" Opacity="0.45"/>
                        <Path x:Name="CornerMask" Fill="{DynamicResource BgA3}" IsHitTestVisible="False"/>
                        <!-- play / pause flash after a click on the picture -->
                        <Border x:Name="VideoFlash" Width="88" Height="88" CornerRadius="44" Background="{DynamicResource MenuBg}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Opacity="0" IsHitTestVisible="False">
                    <local:Icon x:Name="VideoFlashIcon" Glyph="play-fill" Width="38" Height="38" Tint="@FgA0"/>
                </Border>
                        <Border x:Name="OsdBorder" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24" Padding="12,6"
                                CornerRadius="6" Background="{DynamicResource MenuBg}" Opacity="0" IsHitTestVisible="False">
                            <TextBlock x:Name="OsdText" FontSize="16" Foreground="{DynamicResource FgA1}" FontFamily="{StaticResource Inter}"/>
                        </Border>
                        <!-- "You've watched till … already. Continue Watching" (hidden frame in the mockup) -->
                        <Border x:Name="ResumeBanner" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Padding="20,10,10,10"
                                CornerRadius="10" Background="{DynamicResource MenuBg}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ResumeText" FontSize="16" Foreground="{DynamicResource FgA1}" VerticalAlignment="Center" Margin="0,0,40,0" FontFamily="{StaticResource Inter}"/>
                                <Button Content="{local:T 'Continue Watching'}" Style="{StaticResource PrimaryButton}" Click="Resume_Click" FontFamily="{StaticResource Inter}"/>
                                <Button Style="{StaticResource IconButton}" Tag="x" Margin="6,0,0,0" Click="ResumeClose_Click"/>
                            </StackPanel>
                        </Border>
                        <ContentControl x:Name="OverlayControlsHost" VerticalAlignment="Bottom"/>
                    </Grid>
                </vlc:VideoView>
            </Grid>
        </Grid>

        <!-- ───── Controls ───── -->
        <Border x:Name="ControlsBar" Grid.Row="2" Height="54" Background="{DynamicResource BgA3}" BorderBrush="{DynamicResource DividerDim}">
            <DockPanel Margin="20,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrevBtn" Style="{StaticResource IconButton}" Tag="skip-back-fill" Padding="3,2" Click="Prev_Click" ToolTip="{local:T 'Previous (P)'}"/>
                    <Button x:Name="StopBtn" Style="{StaticResource IconButton}" Tag="stop-fill" Padding="3,2" Margin="8,0,0,0" Click="Stop_Click" ToolTip="{local:T 'Stop (S)'}" Visibility="Collapsed"/>
                    <Button x:Name="Back15" Style="{StaticResource IconButton}" Padding="3,2" Margin="8,0,0,0" Click="Back15_Click" Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="3,2">
                                    <Grid Width="24" Height="24">
                                        <local:Icon Glyph="arrow-counter-clockwise"/>
                                        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource FgA2}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <ToggleButton x:Name="PlayBtn" Style="{StaticResource PlayButton}" Margin="8,0" Click="Play_Click"/>
                    <Button x:Name="Fwd15" Style="{StaticResource IconButton}" Margin="0,0,8,0" Click="Fwd15_Click" Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="3,2">
                                    <Grid Width="24" Height="24">
                                        <local:Icon Glyph="arrow-clockwise"/>
                                        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource FgA2}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="NextBtn" Style="{StaticResource IconButton}" Tag="skip-forward-fill" Padding="3,2" Click="Next_Click" ToolTip="{local:T 'Next (N)'}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button x:Name="FrameBtn" Style="{StaticResource IconButton}" Tag="film-strip" Width="30" Margin="0,0,12,0" Click="Frame_Click" ToolTip="{local:T 'Next frame (.)'}" Visibility="Collapsed"/>
                    <Button x:Name="SpeedBtn" Style="{StaticResource FlatButton}" Height="28" Padding="6,0" Margin="0,0,12,0" Click="PSettings_Click" ToolTip="{local:T 'Playback speed'}" Visibility="Collapsed">
                        <TextBlock x:Name="SpeedText" Text="1×" FontSize="14"/>
                    </Button>
                    <Button x:Name="SnapBtn" Style="{StaticResource IconButton}" Tag="camera" Width="30" Margin="0,0,12,0" Click="Snap_Click" ToolTip="{local:T 'Take a snapshot (Shift+S)'}" Visibility="Collapsed"/>
                    <ToggleButton x:Name="RecordBtn" Style="{StaticResource IconButton}" Tag="record" Width="30" Margin="0,0,12,0" Click="Record_Click" ToolTip="{local:T 'Record (Shift+R)'}" Visibility="Collapsed"/>
                    <ToggleButton x:Name="AbBtn" Style="{StaticResource IconButton}" Tag="brackets-square" Width="30" Margin="0,0,12,0" Click="Ab_Click" ToolTip="{local:T 'A-B loop (Shift+L)'}" Visibility="Collapsed"/>
                    <ToggleButton x:Name="LoopBtn" Style="{StaticResource IconButton}" Tag="repeat" Width="30" Margin="0,0,12,0" Click="Loop_Click" ToolTip="{local:T 'Repeat'}" Visibility="Collapsed"/>
                    <ToggleButton x:Name="ShuffleBtn" Style="{StaticResource IconButton}" Tag="shuffle" Width="30" Margin="0,0,12,0" Click="Shuffle_Click" ToolTip="{local:T 'Shuffle'}" Visibility="Collapsed"/>
                    <Button x:Name="MuteBtn" Style="{StaticResource IconButton}" Tag="speaker-high" Padding="0" Click="Mute_Click" ToolTip="{local:T 'Mute (M)'}"/>
                    <local:VolumeBar x:Name="Volume" Margin="8,0,0,0"/>
                    <ToggleButton x:Name="LyricsBtn" Style="{StaticResource IconButton}" Tag="microphone-stage" Width="30" Margin="20,0,0,0" Click="Lyrics_Click" ToolTip="{local:T 'Lyrics'}" Visibility="Collapsed"/>
                    <Button x:Name="AudioBtn" Style="{StaticResource IconButton}" Tag="waveform" Width="30" Margin="20,0,0,0" Click="Audio_Click" ToolTip="{local:T 'Audio'}"/>
                    <Button x:Name="SubsBtn" Style="{StaticResource IconButton}" Tag="subtitles" Width="30" Margin="12,0,0,0" Click="Subs_Click" ToolTip="{local:T 'Subtitles'}"/>
                    <Button x:Name="PSettingsBtn" Style="{StaticResource IconButton}" Tag="sliders-horizontal" Width="30" Margin="12,0,0,0" Click="PSettings_Click" ToolTip="{local:T 'Playback'}"/>
                    <Button x:Name="FullBtn" Style="{StaticResource IconButton}" Tag="corners-out" Width="30" Margin="12,0,0,0" Click="Full_Click" ToolTip="{local:T 'Fullscreen (F)'}" Visibility="Collapsed"/>
                    <ToggleButton x:Name="ListBtn" Style="{StaticResource IconButton}" Tag="queue" Width="30" Margin="20,0,0,0" Click="ListBtn_Click" ToolTip="{local:T 'Now playing'}"/>
                    <Button x:Name="MiniBtn" Style="{StaticResource IconButton}" Tag="picture-in-picture" Width="30" Margin="12,0,0,0" Click="Mini_Click" ToolTip="{local:T 'Miniplayer (Ctrl+M)'}" Visibility="Collapsed"/>
                </StackPanel>

                <Grid Margin="20,0,0,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="76"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource FlatButton}" Height="28" Padding="0" HorizontalContentAlignment="Center" Cursor="Arrow">
                        <TextBlock x:Name="TimeText" Text="--:--:--" FontSize="15"/>
                    </Button>
                    <local:SeekBar x:Name="Seek" Grid.Column="1" Margin="8,0" MouseMove="Seek_MouseMove" MouseLeave="Seek_MouseLeave"/>
                    <Button Grid.Column="2" Style="{StaticResource FlatButton}" Height="28" Padding="0" HorizontalContentAlignment="Center" Click="Duration_Click"
                            ToolTip="{local:T 'Toggle remaining time'}">
                        <TextBlock x:Name="DurationText" Text="--:--:--" FontSize="15"/>
                    </Button>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ───── Miniplayer controls (compact window mode) ───── -->
        <Border x:Name="MiniBar" Grid.Row="2" Background="{DynamicResource BgA3}" Padding="14,10,14,12" Visibility="Collapsed" Height="118" MouseLeftButtonDown="DragArea_MouseDown">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="MiniTime" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource FgA3}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MiniTitle" Text="Pylon" FontSize="13" Foreground="{DynamicResource FgA1}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
                <local:SeekBar x:Name="MiniSeek" Height="20"/>
                <Grid Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource IconButton}" Tag="arrows-out-simple" Click="Mini_Click" ToolTip="{local:T 'Back to the full player'}"/>
                        <Button Style="{StaticResource IconButton}" Tag="queue" Margin="4,0,0,0" Click="MiniQueue_Click" ToolTip="{local:T 'Now playing'}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Tag="skip-back-fill" Click="Prev_Click"/>
                        <ToggleButton x:Name="MiniPlay" Style="{StaticResource PlayButton}" Margin="10,0" Click="Play_Click"/>
                        <Button Style="{StaticResource IconButton}" Tag="skip-forward-fill" Click="Next_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="MiniMute" Style="{StaticResource IconButton}" Tag="speaker-high" Click="Mute_Click"/>
                        <Button Style="{StaticResource IconButton}" Tag="x" Margin="4,0,0,0" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Seek preview (mockup "thumbnail" 272x189: frame + time) -->
        <!-- The popup window spans the whole bar and stays put; only the card slides inside it.
             Moving a transparent popup window on every mouse move made it flicker and flash black. -->
        <Popup x:Name="SeekPreview" PlacementTarget="{Binding ElementName=Seek}" Placement="Top" AllowsTransparency="True" IsHitTestVisible="False" VerticalOffset="16">
            <Grid x:Name="PreviewLane" HorizontalAlignment="Left">
                <Border x:Name="PreviewSlider" HorizontalAlignment="Left" Padding="0,0,0,24">
                    <Border.RenderTransform><TranslateTransform x:Name="PreviewX"/></Border.RenderTransform>
                    <Border x:Name="PreviewCard" Background="{DynamicResource MenuBg}" CornerRadius="10" Padding="4">
                        <Border.Effect><DropShadowEffect BlurRadius="15" ShadowDepth="8" Direction="270" Opacity="0.46"/></Border.Effect>
                        <StackPanel>
                            <Border x:Name="PreviewFrame" Width="256" Height="144" CornerRadius="7" ClipToBounds="True" Background="Black">
                                <Image x:Name="PreviewImage" Stretch="Uniform"/>
                            </Border>
                            <TextBlock x:Name="PreviewTime" FontSize="14" Foreground="{DynamicResource FgA1}" HorizontalAlignment="Center" Margin="10,6,10,6"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Popup>

        <!-- Customize Player: which buttons the control bar shows -->
        <Popup x:Name="CustomizePopup" PlacementTarget="{Binding ElementName=ControlsBar}" Placement="Top" AllowsTransparency="True" StaysOpen="False" HorizontalOffset="20" VerticalOffset="-8">
            <Border Background="{DynamicResource MenuBg}" CornerRadius="10" Padding="20,16,20,10" Margin="0,0,16,24" Width="420">
                <Border.Effect><DropShadowEffect BlurRadius="15" ShadowDepth="8" Direction="270" Opacity="0.46"/></Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="{local:T 'Done'}" Style="{StaticResource PrimaryButton}" MinWidth="80" Click="CustomizeDone_Click"/>
                        <StackPanel>
                            <TextBlock Text="{local:T 'Customize Player'}" FontSize="16" Foreground="{DynamicResource FgA0}"/>
                            <TextBlock Text="{local:T 'Choose the buttons on the control bar.'}" FontSize="13" Foreground="{DynamicResource FgA3}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel x:Name="CustomizeList"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
