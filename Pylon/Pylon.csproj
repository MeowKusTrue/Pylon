<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>Pylon.Program</StartupObject>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Pylon</AssemblyName>
    <RootNamespace>Pylon</RootNamespace>
    <ApplicationIcon>Assets\pylon.ico</ApplicationIcon>

    <Version>1.9.0</Version>
    <Product>Pylon</Product>
    <Description>A media player built on libVLC, with a redesigned VLC interface.</Description>
    <Copyright>GPL-3.0-or-later</Copyright>

    <!-- Release builds: self-contained x64, so users don't need the .NET runtime -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- libVLC ships x86/arm64 copies too; only x64 is used -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\*.svg" />
    <Resource Include="Assets\pylon.ico" />
    <!-- license texts travel with every build (LGPL notice for libVLC) -->
    <None Include="..\LICENSE;..\THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <!-- Explorer icons for associated files (installer DefaultIcon) -->
    <None Include="Assets\FileIcons\*.ico" CopyToOutputDirectory="PreserveNewest" Link="FileIcons\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
