<UserControl x:Class="Pylon.LibraryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pylon"
             Width="427" FontFamily="{StaticResource Inter}">
    <UserControl.Resources>
        <!-- One list row: section header, icon row (folders/actions) or media row with 32px thumbnail + progress -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:Row}">
            <Border x:Name="bd" Height="32" Padding="4,0" Margin="-4,0,-4,10" CornerRadius="4" Background="Transparent" Cursor="Hand"
                    Loaded="Row_Loaded" ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="900">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="thumb" Width="32" Height="32" CornerRadius="2" Background="{DynamicResource ThumbBg}" ClipToBounds="True" Visibility="Collapsed">
                        <Grid>
                            <local:Icon x:Name="placeholder" Glyph="{Binding PlaceholderGlyph}" Width="18" Height="18" Tint="@FgA3"/>
                            <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                            <Rectangle Fill="{DynamicResource Accent}" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="{Binding ProgressWidth}"/>
                            <!-- the song that's playing: three bouncing bars over its cover -->
                            <Grid x:Name="eq" Background="#A0000000" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Height="14">
                                    <Rectangle Width="3" Height="14" RadiusX="1" RadiusY="1" Fill="White" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform><ScaleTransform x:Name="eq1" ScaleY="0.5"/></Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle Width="3" Height="14" RadiusX="1" RadiusY="1" Fill="White" VerticalAlignment="Bottom" Margin="2,0" RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform><ScaleTransform x:Name="eq2" ScaleY="0.9"/></Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle Width="3" Height="14" RadiusX="1" RadiusY="1" Fill="White" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform><ScaleTransform x:Name="eq3" ScaleY="0.35"/></Rectangle.RenderTransform>
                                    </Rectangle>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <local:Icon x:Name="glyph" Glyph="{Binding Glyph}" Tint="{Binding GlyphTint}"/>
                    <TextBlock x:Name="title" Grid.Column="1" Text="{Binding Title}" Margin="10,0,0,0" FontSize="14" Foreground="{DynamicResource FgA1}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <local:Icon x:Name="chevron" Grid.Column="2" Glyph="caret-right" Width="20" Height="20" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasThumbBox}" Value="True">
                    <Setter TargetName="thumb" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="glyph" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Dim}" Value="True">
                    <Setter TargetName="title" Property="Foreground" Value="{DynamicResource FgA3}"/>
                </DataTrigger>
                <!-- what's playing: a backdrop, bright semibold title and the bars (24 fps is plenty for them) -->
                <DataTrigger Binding="{Binding Active}" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Checked}"/>
                    <Setter TargetName="bd" Property="Margin" Value="0,0,0,10"/> <!-- the list clips a negative margin: the backdrop shows round the cover too -->
                    <Setter TargetName="bd" Property="Height" Value="40"/>
                    <Setter TargetName="bd" Property="Padding" Value="4"/>
                    <Setter TargetName="title" Property="Foreground" Value="{DynamicResource FgA0}"/>
                    <Setter TargetName="title" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="eq" Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="eqRun">
                            <Storyboard Timeline.DesiredFrameRate="24" RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="eq1" Storyboard.TargetProperty="ScaleY" From="0.3" To="1" Duration="0:0:0.45" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="eq2" Storyboard.TargetProperty="ScaleY" From="1" To="0.25" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="eq3" Storyboard.TargetProperty="ScaleY" From="0.5" To="0.95" Duration="0:0:0.38" AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="eqRun"/></DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter TargetName="glyph" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="title" Property="Grid.Column" Value="0"/>
                    <Setter TargetName="title" Property="Grid.ColumnSpan" Value="2"/>
                    <Setter TargetName="title" Property="Margin" Value="0"/>
                    <Setter TargetName="title" Property="FontSize" Value="16"/>
                    <Setter TargetName="bd" Property="Margin" Value="-4,10,-4,10"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowChevron}" Value="True">
                    <Setter TargetName="chevron" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <Trigger SourceName="bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Rail: #191919, p8, gap 14 -->
        <Border Background="{DynamicResource BgA4}">
            <StackPanel x:Name="Rail" Margin="0,8"/>
        </Border>

        <!-- Panel: rgba(14,14,14,.95), p20 -->
        <Border Grid.Column="1" Background="{DynamicResource PanelBg}" Padding="20,20,20,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel Height="24">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button x:Name="BackBtn" Style="{StaticResource IconButton}" Tag="arrow-left" Padding="0" Click="Back_Click" ToolTip="{local:T 'Back'}"/>
                            <Button x:Name="ForwardBtn" Style="{StaticResource IconButton}" Tag="arrow-right" Padding="0" Margin="12,0,0,0" Click="Forward_Click" ToolTip="{local:T 'Forward'}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="MoreBtn" Style="{StaticResource IconButton}" Tag="dots-three" Padding="0" Click="More_Click" ToolTip="{local:T 'More'}"/>
                            <Button x:Name="PopoutBtn" Style="{StaticResource IconButton}" Tag="arrow-square-out" Padding="0" Margin="12,0,0,0" Click="Popout_Click" ToolTip="{local:T 'Show in Explorer'}"/>
                        </StackPanel>
                        <StackPanel x:Name="Crumbs" Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center" ClipToBounds="True"/>
                    </DockPanel>
                    <DockPanel Height="28" Margin="0,18,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SortBtn" Style="{StaticResource IconButton}" Tag="sort-ascending" Padding="0" Click="Sort_Click" ToolTip="{local:T 'Sort by name'}"/>
                            <ToggleButton x:Name="SearchBtn" Style="{StaticResource IconButton}" Tag="magnifying-glass" Padding="0" Margin="12,0,0,0" Click="Search_Click" ToolTip="{local:T 'Search (Ctrl+K)'}"/>
                        </StackPanel>
                        <Grid Margin="0,0,12,0">
                            <TextBlock x:Name="CountText" FontSize="14" Foreground="{DynamicResource FgA3}" VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Tag="{local:T Search…}" Padding="8,3" Height="28" Visibility="Collapsed"
                                     TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_KeyDown"/>
                        </Grid>
                    </DockPanel>
                    <Border Height="1" Background="{DynamicResource DividerDim}" Margin="0,16,0,0"/>
                </StackPanel>

                <ListBox x:Name="List" ItemTemplate="{StaticResource RowTemplate}" Background="Transparent" BorderThickness="0" Padding="0,20,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         Focusable="False">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="MouseLeftButtonUp" Handler="Item_Click"/>
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Item_MouseDown"/>
                            <EventSetter Event="PreviewMouseMove" Handler="Item_MouseMove"/>
                            <EventSetter Event="Drop" Handler="Item_Drop"/>
                            <Setter Property="AllowDrop" Value="True"/>
                            <EventSetter Event="MouseRightButtonUp" Handler="Item_RightClick"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
