<!-- Dark tokens from the Figma file (Dark/*). Accent brushes are generated by ThemeManager from the chosen accent color. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgA3" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="BgA4" Color="#191919"/>
    <SolidColorBrush x:Key="BgB1" Color="#0E0E0E"/>
    <SolidColorBrush x:Key="BgB2" Color="#090909"/>
    <SolidColorBrush x:Key="BgRaised" Color="#232323"/>
    <SolidColorBrush x:Key="FgA0" Color="#C6C6C6"/>
    <SolidColorBrush x:Key="FgA1" Color="#969696"/>
    <SolidColorBrush x:Key="FgA2" Color="#8F8F8F"/>
    <SolidColorBrush x:Key="FgA3" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="FgA4" Color="#404040"/>
    <SolidColorBrush x:Key="FgB1" Color="#161616"/>
    <SolidColorBrush x:Key="OnAccent" Color="#161616"/>
    <SolidColorBrush x:Key="DividerBright" Color="#373737"/>
    <SolidColorBrush x:Key="DividerDim" Color="#222222"/>
    <SolidColorBrush x:Key="Hover" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Checked" Color="#29FFFFFF"/> <!-- a toggle that is on -->
    <SolidColorBrush x:Key="MenuBg" Color="#F2191919"/>
    <SolidColorBrush x:Key="PanelBg" Color="#F20E0E0E"/>
    <SolidColorBrush x:Key="StageBg" Color="#000000"/>
    <SolidColorBrush x:Key="ThumbBg" Color="#303030"/>
</ResourceDictionary>
